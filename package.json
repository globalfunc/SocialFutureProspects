{
  "name": "social-future-prospects",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Speaker Prospects review app — React + Tailwind + Vite, storage layer per design.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "esbuild scripts/seedSupabase.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/seedSupabase.mjs && node node_modules/.cache/seedSupabase.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "react-router-dom": "^7.18.3"
  }
}
