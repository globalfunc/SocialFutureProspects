# Copy to .env.local (gitignored) before deploying for real use.
# The passphrase gates writes only (CLAUDE.md: "friction, not cryptographic
# security" — it ends up in the public bundle same as everything else here).
VITE_WRITE_PASSPHRASE=sofia2026

# Supplied later once Stoyan creates the Supabase project (Phase 1 decision).
# Until both are set, the app runs against the in-memory storage mock.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
